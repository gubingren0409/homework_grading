# PostgreSQL Configuration Example
# Copy this to .env and update with your values

# Database Configuration
DATABASE_TYPE=postgresql
POSTGRESQL_URL=postgresql://grader:grader_password_change_in_production@localhost:5432/grading

# For SQLite (legacy, keep for rollback)
# DATABASE_TYPE=sqlite
# SQLITE_DB_PATH=outputs/grading_database.db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API Keys (add your actual keys)
QWEN_API_KEYS=your-qwen-api-key
DEEPSEEK_API_KEYS=your-deepseek-api-key

# Other settings...
